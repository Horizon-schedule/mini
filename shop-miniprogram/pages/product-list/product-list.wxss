.page-product-list { height: 100vh; display: flex; flex-direction: column; background: #f5f5f5; }

.sort-bar { display: flex; background: #fff; padding: 20rpx 0; border-bottom: 1rpx solid #eee; }
.sort-item { flex: 1; text-align: center; font-size: 28rpx; color: #666; padding: 10rpx 0; }
.sort-item.active { color: #FF6B35; font-weight: bold; }

.product-scroll { flex: 1; padding: 20rpx; }
.product-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.product-item { width: 340rpx; margin-bottom: 20rpx; padding: 0; overflow: hidden; }
.product-img { width: 100%; height: 340rpx; }
.product-info { padding: 16rpx; }
.product-name { font-size: 28rpx; line-height: 1.4; height: 78rpx; display: block; margin-bottom: 12rpx; }
.product-bottom { display: flex; align-items: baseline; margin-bottom: 8rpx; }
.product-sales { font-size: 22rpx; color: #bbb; }
