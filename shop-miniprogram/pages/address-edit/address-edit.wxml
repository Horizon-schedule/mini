<!-- 地址编辑页 -->
<view class="page-address-edit">
  <view class="form-card card">
    <view class="form-item">
      <text class="form-label">收货人</text>
      <input class="form-input" placeholder="请输入收货人姓名" value="{{form.name}}" bindinput="onInput" data-field="name" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" placeholder="请输入手机号" type="number" value="{{form.phone}}" bindinput="onInput" data-field="phone" maxlength="11" />
    </view>
    <view class="form-item" bindtap="chooseAddress">
      <text class="form-label">所在地区</text>
      <text class="form-value {{form.province ? '' : 'placeholder'}}">{{form.province ? form.province + ' ' + form.city + ' ' + form.district : '点击获取微信地址'}}</text>
      <text class="form-arrow">></text>
    </view>
    <!-- 手动输入地区（备用） -->
    <view class="form-item manual-region" wx:if="{{!form.province}}">
      <input class="form-input small" placeholder="省" value="{{form.province}}" bindinput="onInput" data-field="province" />
      <input class="form-input small" placeholder="市" value="{{form.city}}" bindinput="onInput" data-field="city" />
      <input class="form-input small" placeholder="区/县" value="{{form.district}}" bindinput="onInput" data-field="district" />
    </view>
    <view class="form-item">
      <text class="form-label">详细地址</text>
      <input class="form-input" placeholder="街道、楼牌号等" value="{{form.detail}}" bindinput="onInput" data-field="detail" />
    </view>
    <view class="form-item">
      <text class="form-label">邮政编码</text>
      <input class="form-input" placeholder="选填" type="number" value="{{form.postal_code}}" bindinput="onInput" data-field="postal_code" />
    </view>
  </view>

  <!-- 设为默认 -->
  <view class="default-row card" bindtap="toggleDefault">
    <text>设为默认地址</text>
    <view class="switch {{form.is_default ? 'on' : ''}}">
      <view class="switch-dot"></view>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-btn" bindtap="saveAddress">保存</view>
</view>
