.page-review-list {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

/* 商品信息 */
.product-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.product-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}
.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.product-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.product-price {
  font-size: 32rpx;
  color: #FF6B35;
  font-weight: bold;
}

/* 评价标签 */
.tags-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
}
.tag-item {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
  border: 2rpx solid transparent;
}
.tag-item.active {
  background: rgba(93, 173, 226, 0.1);
  color: #5DADE2;
  border-color: #5DADE2;
}

/* 评价列表 */
.review-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.review-item {
  padding: 24rpx;
}
.review-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.review-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}
.review-meta {
  flex: 1;
}
.review-nickname {
  font-size: 26rpx;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}
.review-rating {
  font-size: 20rpx;
}
.review-date {
  font-size: 22rpx;
  color: #999;
}
.review-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
}
.review-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.review-images image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}

/* 加载状态 */
.loading-more, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
