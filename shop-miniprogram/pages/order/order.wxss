.page-order-list { height: 100vh; display: flex; flex-direction: column; background: #f5f5f5; }

.order-tabs { display: flex; background: #fff; border-bottom: 1rpx solid #eee; }
.tab-item { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: #666; position: relative; }
.tab-item.active { color: #FF6B35; font-weight: bold; }
.tab-item.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 60rpx; height: 4rpx; background: #FF6B35; border-radius: 2rpx; }

.order-scroll { flex: 1; padding: 20rpx; }

.order-card { padding: 24rpx; margin-bottom: 20rpx; }
.order-header { display: flex; justify-content: space-between; margin-bottom: 20rpx; }
.order-no { font-size: 24rpx; color: #999; }
.order-status { font-size: 28rpx; font-weight: bold; }

.order-goods { display: flex; align-items: center; padding: 16rpx 0; border-top: 1rpx solid #f5f5f5; border-bottom: 1rpx solid #f5f5f5; margin-bottom: 16rpx; }
.order-goods-img { width: 80rpx; height: 80rpx; border-radius: 8rpx; margin-right: 16rpx; }
.order-goods-text { font-size: 26rpx; color: #666; }

.order-footer { display: flex; align-items: center; justify-content: space-between; }
.order-amount { font-size: 26rpx; color: #666; }
.order-actions { display: flex; }
.action-btn { padding: 8rpx 24rpx; font-size: 24rpx; border-radius: 30rpx; margin-left: 16rpx; }
.action-btn.outline { border: 2rpx solid #ddd; color: #666; }
.action-btn.primary { background: #5DADE2; color: #fff; }
