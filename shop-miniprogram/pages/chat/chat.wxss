/* 客服聊天页面 - 仿微信样式 */
.page-chat {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ededed;
}

/* 商品卡片 */
.product-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: relative;
}

.product-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.product-price {
  font-size: 32rpx;
  color: #FF6B35;
  font-weight: bold;
}

.product-card-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.view-btn {
  padding: 12rpx 24rpx;
  background: #5DADE2;
  color: #fff;
  font-size: 24rpx;
  border-radius: 30rpx;
}

.close-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 50%;
  font-size: 24rpx;
  color: #666;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 20rpx;
}

.message-item {
  margin-bottom: 30rpx;
}

.msg-time {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
  background: rgba(0,0,0,0.1);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
  left: 50%;
  transform: translateX(-50%);
  position: relative;
}

.msg-content {
  display: flex;
  align-items: flex-start;
}

.msg-content.user {
  justify-content: flex-end;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  margin: 0 20rpx;
  flex-shrink: 0;
}

.msg-bubble {
  max-width: 60%;
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  background: #fff;
  font-size: 30rpx;
  color: #333;
  line-height: 1.4;
  word-break: break-all;
  position: relative;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.05);
}

/* 左侧气泡小三角 */
.msg-content:not(.user) .msg-bubble::before {
  content: '';
  position: absolute;
  left: -16rpx;
  top: 24rpx;
  width: 0;
  height: 0;
  border: 8rpx solid transparent;
  border-right-color: #fff;
}

/* 右侧气泡小三角 */
.user .msg-bubble {
  background: #95ec69;
  color: #000;
}

.user .msg-bubble::before {
  content: '';
  position: absolute;
  right: -16rpx;
  top: 24rpx;
  width: 0;
  height: 0;
  border: 8rpx solid transparent;
  border-left-color: #95ec69;
}

.msg-bubble image {
  max-width: 100%;
  border-radius: 8rpx;
}

/* 聊天中的商品卡片 */
.chat-product-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 8rpx;
  padding: 16rpx;
  min-width: 400rpx;
  border: 1rpx solid #e5e5e5;
}

.chat-product-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.chat-product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.chat-product-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.chat-product-price {
  font-size: 32rpx;
  color: #FF6B35;
  font-weight: bold;
}

/* 底部输入框 - 仿微信 */
.input-bar {
  display: flex;
  align-items: flex-end;
  padding: 20rpx 24rpx;
  background: #f7f7f7;
  border-top: 1rpx solid #e5e5e5;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.input-wrap {
  flex: 1;
  background: #fff;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  margin-right: 20rpx;
  border: 1rpx solid #e5e5e5;
  min-height: 72rpx;
  max-height: 200rpx;
}

.msg-input {
  font-size: 30rpx;
  line-height: 1.4;
  color: #333;
  width: 100%;
  box-sizing: border-box;
}

.btn-send {
  padding: 16rpx 36rpx;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.btn-send:active {
  background: #06ad56;
}