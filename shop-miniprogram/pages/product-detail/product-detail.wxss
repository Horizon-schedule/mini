.page-detail { padding-bottom: 120rpx; background: #f5f5f5; }

.img-swiper { width: 100%; height: 750rpx; }
.detail-img { width: 100%; height: 750rpx; }

.price-section { background: linear-gradient(135deg, #FF6B35, #FF8C5A); padding: 24rpx 30rpx; }
.price-row { display: flex; align-items: baseline; }
.price-section .price { color: #fff; }
.price-section .price-symbol { font-size: 28rpx; }
.price-section .price-integer { font-size: 48rpx; }
.price-section .original-price { color: rgba(255,255,255,0.7); margin-left: 16rpx; }
.sales-info { color: rgba(255,255,255,0.8); font-size: 24rpx; margin-top: 8rpx; display: block; }

.info-section { margin: 20rpx; }
.product-title { font-size: 32rpx; font-weight: bold; line-height: 1.5; display: block; }
.product-subtitle { font-size: 26rpx; color: #999; margin-top: 8rpx; display: block; }

.spec-section { margin: 20rpx; }
.spec-group { margin-bottom: 20rpx; }
.spec-label { font-size: 28rpx; color: #666; display: block; margin-bottom: 16rpx; }
.spec-options { display: flex; flex-wrap: wrap; }
.spec-option { padding: 12rpx 28rpx; border: 2rpx solid #ddd; border-radius: 8rpx; font-size: 26rpx; margin-right: 16rpx; margin-bottom: 16rpx; }
.spec-option.selected { border-color: #5DADE2; color: #5DADE2; background: #E3F2FD; }
.selected-spec-text { font-size: 24rpx; color: #999; display: block; margin-top: 10rpx; }

/* 商品详情图片区域 */
.detail-images-section { margin: 20rpx; }
.detail-title { font-size: 30rpx; font-weight: bold; display: block; margin-bottom: 20rpx; }
.detail-images { width: 100%; }
.detail-img-item { width: 100%; display: block; margin-bottom: 10rpx; }

/* 卡片基础样式 */
.card {
  background: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

/* 发货信息 */
.delivery-section { }
.delivery-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.delivery-item:last-child { border-bottom: none; }
.delivery-label {
  width: 100rpx;
  font-size: 26rpx;
  color: #999;
}
.delivery-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}
.delivery-tag {
  font-size: 24rpx;
  color: #FF6B35;
  background: #FFF5F0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
}
.promise-tags {
  display: flex;
  flex-wrap: wrap;
}
.promise-tag {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  margin-bottom: 10rpx;
}

/* 评价区域 */
.review-section { }
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
}
.section-more {
  font-size: 26rpx;
  color: #999;
}
.review-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}
.review-tag {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}
.review-tag.active {
  color: #5DADE2;
  background: #E3F2FD;
}
.review-list { }
.review-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.review-item:last-child { border-bottom: none; }
.review-user {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}
.user-name {
  font-size: 26rpx;
  color: #666;
  flex: 1;
}
.user-rating {
  display: flex;
}
.star {
  font-size: 24rpx;
  color: #FFB800;
  margin-left: 4rpx;
}
.review-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  display: block;
  margin-bottom: 12rpx;
}
.review-date {
  font-size: 24rpx;
  color: #999;
}

/* 问大家 */
.qa-section { }
.qa-list { margin-bottom: 20rpx; }
.qa-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.qa-item:last-child { border-bottom: none; }
.qa-question, .qa-answer {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}
.qa-tag {
  font-size: 22rpx;
  color: #fff;
  background: #5DADE2;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.qa-tag.answer {
  background: #4CAF50;
}
.qa-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  flex: 1;
}
.qa-btn {
  text-align: center;
  font-size: 28rpx;
  color: #5DADE2;
  padding: 20rpx;
  border: 2rpx solid #5DADE2;
  border-radius: 32rpx;
  margin-top: 10rpx;
}

/* 店铺信息 */
.shop-section { }
.shop-header {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.shop-logo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
}
.shop-info {
  flex: 1;
}
.shop-name {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}
.shop-desc {
  font-size: 24rpx;
  color: #999;
}
.shop-score {
  display: flex;
  flex-direction: column;
}
.score-item {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.score-label {
  font-size: 22rpx;
  color: #999;
  margin-right: 8rpx;
}
.score-value {
  font-size: 22rpx;
  color: #FF6B35;
}
.score-value.high {
  color: #FF4D4F;
  font-weight: bold;
}
.shop-stats {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.stat-item {
  text-align: center;
}
.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}
.stat-label {
  font-size: 24rpx;
  color: #999;
}
.shop-actions {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
}
.shop-btn {
  display: flex;
  align-items: center;
  padding: 16rpx 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666;
}
.shop-btn.primary {
  background: #FF6B35;
  color: #fff;
  border-color: #FF6B35;
}
.btn-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

/* 店铺推荐 */
.recommend-section {
  background: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}
.recommend-header {
  margin-bottom: 20rpx;
}
.recommend-title {
  font-size: 30rpx;
  font-weight: bold;
}
.recommend-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.recommend-item {
  width: 220rpx;
  margin-bottom: 20rpx;
}
.recommend-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.recommend-name {
  font-size: 26rpx;
  color: #333;
  line-height: 1.3;
  height: 68rpx;
  overflow: hidden;
  display: block;
  margin-bottom: 8rpx;
}
.recommend-price {
  color: #FF6B35;
  font-weight: bold;
}
.recommend-price .price-symbol {
  font-size: 22rpx;
}
.recommend-price .price-value {
  font-size: 30rpx;
}
.recommend-sales {
  font-size: 22rpx;
  color: #999;
}

.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; background: #fff; padding: 10rpx 20rpx; box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05); z-index: 100; }
.bar-icons { display: flex; width: 180rpx; }
.bar-icon { display: flex; flex-direction: column; align-items: center; font-size: 20rpx; color: #666; width: 90rpx; position: relative; }
.iconfont { font-size: 40rpx; }
.cart-badge { position: absolute; top: -8rpx; right: 10rpx; background: #FF4D4F; color: #fff; font-size: 18rpx; min-width: 30rpx; height: 30rpx; line-height: 30rpx; border-radius: 15rpx; text-align: center; padding: 0 6rpx; }
.bar-buttons { flex: 1; display: flex; margin-left: 20rpx; }
.btn-add-cart { flex: 1; height: 72rpx; line-height: 72rpx; text-align: center; background: linear-gradient(135deg, #FFB347, #FFCC33); color: #fff; font-size: 28rpx; border-radius: 36rpx 0 0 36rpx; }
.btn-buy-now { flex: 1; height: 72rpx; line-height: 72rpx; text-align: center; background: linear-gradient(135deg, #FF6B35, #FF8C5A); color: #fff; font-size: 28rpx; border-radius: 0 36rpx 36rpx 0; }

/* 规格选择弹窗 */
.spec-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}
.spec-modal.show {
  opacity: 1;
  visibility: visible;
}
.spec-modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s;
}
.spec-modal.show .spec-modal-content {
  transform: translateY(0);
}
.modal-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 40rpx;
  color: #999;
  z-index: 10;
}
.modal-header {
  display: flex;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.modal-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  border: 2rpx solid #f5f5f5;
}
.modal-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.modal-price {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}
.modal-price .price-symbol {
  font-size: 28rpx;
  color: #FF6B35;
}
.modal-price .price-value {
  font-size: 44rpx;
  color: #FF6B35;
  font-weight: bold;
}
.modal-price .original-price {
  font-size: 26rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 16rpx;
}
.modal-stock {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.modal-selected {
  font-size: 26rpx;
  color: #333;
}
.modal-body {
  flex: 1;
  padding: 30rpx;
  max-height: 50vh;
}
.spec-list {
  margin-bottom: 30rpx;
}
.spec-group-modal {
  margin-bottom: 30rpx;
}
.spec-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}
.spec-options-modal {
  display: flex;
  flex-wrap: wrap;
}
.spec-option-modal {
  padding: 16rpx 32rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  background: #fff;
}
.spec-option-modal.selected {
  border-color: #FF6B35;
  color: #FF6B35;
  background: #FFF5F0;
}
.spec-option-modal.disabled {
  opacity: 0.4;
  background: #f5f5f5;
}
.quantity-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #f5f5f5;
}
.quantity-label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}
.quantity-selector {
  display: flex;
  align-items: center;
  border: 2rpx solid #e5e5e5;
  border-radius: 8rpx;
}
.quantity-btn {
  width: 64rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 32rpx;
  color: #333;
  background: #f5f5f5;
}
.quantity-btn.disabled {
  color: #ccc;
}
.quantity-input {
  width: 80rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  border-left: 2rpx solid #e5e5e5;
  border-right: 2rpx solid #e5e5e5;
}
/* 弹窗内配送信息 */
.delivery-modal-section {
  padding: 20rpx 0;
  border-top: 1rpx solid #f5f5f5;
  margin-top: 20rpx;
}
.delivery-modal-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}
.delivery-modal-label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-right: 20rpx;
  width: 80rpx;
}
.delivery-modal-value {
  font-size: 26rpx;
  color: #666;
  flex: 1;
}
.modal-footer {
  padding: 20rpx 30rpx 40rpx;
  border-top: 1rpx solid #f5f5f5;
}
.modal-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}
.modal-btn.btn-cart {
  background: linear-gradient(135deg, #FFB347, #FFCC33);
}
.modal-btn.btn-buy {
  background: linear-gradient(135deg, #5DADE2, #85C1E9);
}
