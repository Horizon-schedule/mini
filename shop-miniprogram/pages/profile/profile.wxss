.page-profile { background: #f5f5f5; min-height: 100vh; }

.user-header { background: linear-gradient(135deg, #FF6B35, #FF8C5A); padding: 60rpx 30rpx 40rpx; }
.user-info { display: flex; align-items: center; }
.user-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.5); margin-right: 24rpx; }
.user-detail { flex: 1; }
.user-name { font-size: 34rpx; font-weight: bold; color: #fff; display: block; }
.user-tip { font-size: 22rpx; color: rgba(255,255,255,0.8); margin-top: 8rpx; display: block; }

.order-section { padding: 30rpx; margin: 20rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.section-title { font-size: 30rpx; font-weight: bold; }
.section-more { font-size: 24rpx; color: #999; }
.order-icons { display: flex; justify-content: space-around; }
.order-icon-item { display: flex; flex-direction: column; align-items: center; }
.order-icon { font-size: 48rpx; margin-bottom: 8rpx; }
.order-icon-text { font-size: 24rpx; color: #666; }

.menu-section { margin: 20rpx; padding: 0; }
.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 30rpx; border-bottom: 1rpx solid #f5f5f5; font-size: 28rpx; }
.menu-item:last-child { border-bottom: none; }
.menu-arrow { color: #ccc; font-size: 28rpx; }

/* 登录弹窗 */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.login-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 40rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.login-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.login-modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999;
}

.login-modal-body {
  padding: 40rpx;
}

/* 头像选择 */
.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.avatar-btn {
  width: 160rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8f8f8;
  border-radius: 16rpx;
  border: none;
  padding: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}

.avatar-tip {
  font-size: 22rpx;
  color: #999;
}

/* 昵称输入 */
.nickname-input {
  width: 100%;
  height: 88rpx;
  background: #f8f8f8;
  border-radius: 44rpx;
  padding: 0 32rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.nickname-placeholder {
  color: #ccc;
}

/* 使用微信昵称 */
.use-wx-nickname {
  text-align: center;
  color: #FF6B35;
  font-size: 26rpx;
  margin-bottom: 24rpx;
  padding: 10rpx 0;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  background: #fff;
  border: 2rpx solid #ddd;
}

.login-btn::after {
  border: none;
}

.login-btn:last-child {
  margin-bottom: 0;
}

.login-btn.primary {
  background: linear-gradient(135deg, #5DADE2, #85C1E9);
  color: #fff;
  border: none;
}

.login-btn.primary[disabled] {
  background: #ccc;
  color: #fff;
  border: none;
}

.login-btn.secondary {
  background: #fff;
  color: #333;
}

.login-btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.login-btn-text {
  font-size: 28rpx;
}

.login-modal-footer {
  padding: 20rpx 40rpx 40rpx;
  text-align: center;
}

.login-tip {
  font-size: 22rpx;
  color: #999;
}
