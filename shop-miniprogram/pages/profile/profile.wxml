<!-- 个人中心 -->
<view class="page-profile">
  <!-- 用户信息 -->
  <view class="user-header">
    <view class="user-info" bindtap="showLogin">
      <image class="user-avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
      <view class="user-detail">
        <text class="user-name">{{userInfo.nickname || '注册登录'}}</text>
        <text class="user-tip" wx:if="{{!userInfo}}">点击登录/注册</text>
      </view>
    </view>
  </view>

  <!-- 订单入口 -->
  <view class="order-section card">
    <view class="section-header">
      <text class="section-title">我的订单</text>
      <text class="section-more" bindtap="goOrderList" data-status="0">查看全部 ></text>
    </view>
    <view class="order-icons">
      <view class="order-icon-item" bindtap="goOrderList" data-status="1">
        <text class="order-icon">💳</text>
        <text class="order-icon-text">待支付</text>
      </view>
      <view class="order-icon-item" bindtap="goOrderList" data-status="2">
        <text class="order-icon">📦</text>
        <text class="order-icon-text">待发货</text>
      </view>
      <view class="order-icon-item" bindtap="goOrderList" data-status="3">
        <text class="order-icon">🚚</text>
        <text class="order-icon-text">待收货</text>
      </view>
      <view class="order-icon-item" bindtap="goOrderList" data-status="4">
        <text class="order-icon">✅</text>
        <text class="order-icon-text">已完成</text>
      </view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-section card">
    <view class="menu-item" bindtap="goAddressList">
      <text>收货地址</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="logout" wx:if="{{userInfo}}">
      <text>退出登录</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- 登录弹窗 -->
  <view class="login-modal" wx:if="{{showLoginModal}}" bindtap="closeLoginModal">
    <view class="login-modal-content" catchtap="preventBubble">
      <view class="login-modal-header">
        <text class="login-modal-title">登录/注册</text>
        <text class="login-modal-close" bindtap="closeLoginModal">✕</text>
      </view>
      <view class="login-modal-body">
        <!-- 选择头像 -->
        <view class="avatar-section">
          <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image class="avatar-preview" src="{{loginForm.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
            <text class="avatar-tip">点击选择头像</text>
          </button>
        </view>
        
        <!-- 输入昵称 -->
        <input 
          id="nicknameInput"
          class="nickname-input" 
          type="nickname" 
          placeholder="请输入昵称" 
          placeholder-class="nickname-placeholder"
          bindinput="onNicknameInput"
          value="{{loginForm.nickname}}"
          bindblur="onNicknameBlur"
          focus="{{nicknameFocus}}"
        />
        
        <!-- 使用微信昵称 -->
        <view class="use-wx-nickname" bindtap="onUseWxNickname">使用微信昵称</view>
        
        <!-- 确认登录 -->
        <button class="login-btn primary" 
          bindtap="onConfirmLogin" 
          disabled="{{loginBtnDisabled || !loginForm.nickname}}">
          <text class="login-btn-text">确认登录</text>
        </button>
        
        <!-- 手机号登录 -->
        <button class="login-btn secondary" 
          bindtap="onGetPhoneNumber" 
          disabled="{{loginBtnDisabled}}"
          open-type="getPhoneNumber">
          <text class="login-btn-icon">📱</text>
          <text class="login-btn-text">手机号安全登录</text>
        </button>
      </view>
      <view class="login-modal-footer">
        <text class="login-tip">登录即表示同意《用户协议》和《隐私政策》</text>
      </view>
    </view>
  </view>
</view>
