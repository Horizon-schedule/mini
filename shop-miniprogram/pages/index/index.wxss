/* 首页样式 - 蓝天白云背景 */
.page-index {
  padding-bottom: 20rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #4A90D9 0%, #87CEEB 30%, #B8E6F0 60%, #E8F4F8 100%);
  position: relative;
  overflow: hidden;
}

/* 云朵装饰 */
.page-index::before,
.page-index::after {
  content: '';
  position: absolute;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 100rpx;
}

.page-index::before {
  width: 200rpx;
  height: 80rpx;
  top: 100rpx;
  right: -50rpx;
  box-shadow: 
    -100rpx 20rpx 0 -20rpx rgba(255, 255, 255, 0.5),
    -180rpx 40rpx 0 -30rpx rgba(255, 255, 255, 0.4);
}

.page-index::after {
  width: 150rpx;
  height: 60rpx;
  top: 300rpx;
  left: -30rpx;
  box-shadow: 
    80rpx 30rpx 0 -15rpx rgba(255, 255, 255, 0.5),
    150rpx 50rpx 0 -25rpx rgba(255, 255, 255, 0.3);
}

/* 搜索栏 - 透明背景 */
.search-bar {
  padding: 16rpx 24rpx;
  background: transparent;
}

.search-input {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 36rpx;
  padding: 12rpx 24rpx;
  height: 64rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  color: #999;
  font-size: 28rpx;
}

/* 轮播图 */
.banner-swiper {
  width: 100%;
  height: 300rpx;
}

.banner-img {
  width: 100%;
  height: 300rpx;
}

/* 分类 */
.category-section {
  margin: 20rpx 20rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 130rpx;
  margin-right: 20rpx;
}

.category-icon-wrap {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF5F0, #FFE8DB);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.category-icon {
  width: 50rpx;
  height: 50rpx;
}

.category-name {
  font-size: 24rpx;
  color: #666;
}

/* 热门推荐 */
.hot-section {
  margin-top: 20rpx;
}

/* 卡片样式 - 毛玻璃效果 */
.hot-item, .product-item, .category-section {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  display: flex;
  align-items: center;
  padding: 0 24rpx 16rpx;
}

.section-title-tag {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.section-title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.section-more {
  margin-left: auto;
  font-size: 24rpx;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.hot-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.hot-list {
  display: inline-flex;
}

.hot-item {
  display: inline-flex;
  width: 260rpx;
  margin-right: 20rpx;
  padding: 16rpx;
  flex-direction: column;
}

.hot-img {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.hot-info {
  width: 100%;
}

.hot-name {
  font-size: 26rpx;
  display: block;
  margin-bottom: 8rpx;
}

.hot-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hot-sales {
  font-size: 22rpx;
  color: #999;
}

/* 新品列表 */
.new-section {
  margin-top: 20rpx;
  padding: 0 20rpx;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-item {
  width: 340rpx;
  margin-bottom: 20rpx;
  padding: 0;
  overflow: hidden;
}

.product-img {
  width: 100%;
  height: 340rpx;
}

.product-info {
  padding: 16rpx;
}

.product-name {
  font-size: 28rpx;
  line-height: 1.4;
  height: 78rpx;
  display: block;
  margin-bottom: 12rpx;
}

.product-bottom {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.product-sales {
  font-size: 22rpx;
  color: #bbb;
}
