.page-question-list {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

/* 商品信息 */
.product-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.product-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}
.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.product-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.product-price {
  font-size: 32rpx;
  color: #FF6B35;
  font-weight: bold;
}

/* 提问按钮 */
.ask-btn-bar {
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.ask-btn {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
}

/* 问答列表 */
.question-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.question-item {
  padding: 24rpx;
}
.q-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.q-icon {
  width: 36rpx;
  height: 36rpx;
  background: #5DADE2;
  color: #fff;
  border-radius: 8rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.q-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}
.a-header {
  display: flex;
  align-items: flex-start;
  background: #f9f9f9;
  padding: 16rpx;
  border-radius: 8rpx;
  margin-left: 48rpx;
}
.a-icon {
  width: 36rpx;
  height: 36rpx;
  background: #07c160;
  color: #fff;
  border-radius: 8rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.a-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}
.q-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
  margin-left: 48rpx;
}

/* 加载状态 */
.loading-more, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 提问弹窗 */
.ask-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.ask-modal {
  width: 90%;
  max-width: 600rpx;
  padding: 30rpx;
}
.ask-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
}
.close-btn {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}
.ask-input {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.ask-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}
.ask-submit {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
}
