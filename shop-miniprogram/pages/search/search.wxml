<!-- 搜索页 -->
<view class="page-search">
  <!-- 搜索框 -->
  <view class="search-header">
    <view class="search-box">
      <input class="search-input" placeholder="搜索商品" focus="{{true}}" value="{{keyword}}" bindconfirm="doSearch" bindinput="onInput" />
      <image class="search-clear" wx:if="{{keyword}}" src="/images/icon-close.png" mode="aspectFit" bindtap="clearSearch" />
    </view>
    <text class="search-btn" bindtap="doSearch">搜索</text>
  </view>

  <!-- 搜索结果 -->
  <view class="search-results" wx:if="{{searched}}">
    <view class="result-item" wx:for="{{results}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image class="result-img" src="{{item.cover}}" mode="aspectFill" />
      <view class="result-info">
        <text class="result-name text-ellipsis">{{item.name}}</text>
        <text class="price"><text class="price-symbol">¥</text>{{item.price}}</text>
      </view>
    </view>
    <view class="empty-state" wx:if="{{results.length === 0}}">
      <text>未找到相关商品</text>
    </view>
  </view>

  <!-- 热门搜索 -->
  <view class="hot-search" wx:if="{{!searched}}">
    <text class="hot-title">热门搜索</text>
    <view class="hot-tags">
      <text class="hot-tag" wx:for="{{hotWords}}" wx:key="*this" bindtap="quickSearch" data-word="{{item}}">{{item}}</text>
    </view>
  </view>
</view>
