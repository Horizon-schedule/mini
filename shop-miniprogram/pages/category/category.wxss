/* 分类页 */
.page-category {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 */
.nav-header {
  display: flex;
  align-items: center;
  height: 88rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: relative;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  position: absolute;
  left: 0;
  top: 0;
}

.back-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.category-layout {
  display: flex;
  flex: 1;
  height: 100%;
}

.category-left {
  width: 180rpx;
  height: 100%;
  background: #f5f5f5;
}

.category-nav-item {
  padding: 28rpx 16rpx;
  font-size: 28rpx;
  color: #666;
  text-align: center;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.category-icon {
  width: 48rpx;
  height: 48rpx;
}

.category-nav-item.active {
  background: #fff;
  color: #FF6B35;
  font-weight: bold;
}

.category-nav-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 40rpx;
  background: #FF6B35;
  border-radius: 0 4rpx 4rpx 0;
}

.category-right {
  flex: 1;
  height: 100%;
  padding: 20rpx;
  background: #fff;
}

.category-products {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-item {
  width: 230rpx;
  margin-bottom: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  overflow: hidden;
}

.product-img {
  width: 230rpx;
  height: 230rpx;
}

.product-info {
  padding: 12rpx;
}

.product-name {
  font-size: 24rpx;
  line-height: 1.4;
  height: 67rpx;
  display: block;
  margin-bottom: 8rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-sales {
  font-size: 20rpx;
  color: #bbb;
}
