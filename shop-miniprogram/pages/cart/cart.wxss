.page-cart { padding: 20rpx; padding-bottom: 140rpx; }

.cart-item { display: flex; align-items: center; padding: 20rpx; position: relative; }
.cart-check { padding: 10rpx; }
.checkbox { width: 40rpx; height: 40rpx; border-radius: 50%; border: 2rpx solid #ddd; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff; }
.checkbox.checked { background: #5DADE2; border-color: #5DADE2; }
.cart-img { width: 160rpx; height: 160rpx; border-radius: 12rpx; margin: 0 16rpx; }
.cart-info { flex: 1; min-width: 0; }
.cart-name { font-size: 28rpx; display: block; margin-bottom: 8rpx; line-height: 1.4; }
.cart-spec { font-size: 22rpx; color: #999; display: block; margin-bottom: 12rpx; background: #f5f5f5; padding: 4rpx 12rpx; border-radius: 4rpx; display: inline-block; }
.cart-bottom { display: flex; align-items: center; justify-content: space-between; }
.quantity-control { display: flex; align-items: center; }
.qty-btn { width: 48rpx; height: 48rpx; border: 2rpx solid #ddd; display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: #666; }
.qty-num { width: 60rpx; text-align: center; font-size: 28rpx; }
.cart-delete { position: absolute; top: 10rpx; right: 10rpx; width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; color: #ccc; }

.cart-bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; height: 100rpx; background: #fff; box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05); padding: 0 24rpx; z-index: 100; }
.select-all { display: flex; align-items: center; font-size: 28rpx; color: #666; }
.cart-total { flex: 1; text-align: right; font-size: 28rpx; padding-right: 20rpx; }
.settle-btn { background: linear-gradient(135deg, #5DADE2, #85C1E9); color: #fff; padding: 0 40rpx; height: 72rpx; line-height: 72rpx; border-radius: 36rpx; font-size: 28rpx; }
.settle-btn.disabled { opacity: 0.5; }

.go-shop { margin-top: 30rpx; color: #FF6B35; font-size: 28rpx; }
