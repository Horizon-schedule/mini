.page-order-detail { padding-bottom: 120rpx; background: #f5f5f5; }

.status-header { padding: 40rpx 30rpx; color: #fff; }
.status-text { font-size: 36rpx; font-weight: bold; display: block; }
.status-desc { font-size: 26rpx; margin-top: 10rpx; opacity: 0.8; display: block; }

.address-card { padding: 30rpx; }
.address-title { font-size: 28rpx; font-weight: bold; display: block; margin-bottom: 16rpx; }
.address-row { display: flex; margin-bottom: 10rpx; }
.address-name { font-size: 30rpx; font-weight: bold; margin-right: 20rpx; }
.address-phone { font-size: 28rpx; color: #666; }
.address-detail { font-size: 26rpx; color: #666; line-height: 1.5; }

.express-card { padding: 30rpx; }
.express-title { font-size: 28rpx; font-weight: bold; display: block; margin-bottom: 12rpx; }
.express-row { display: flex; justify-content: space-between; align-items: center; font-size: 26rpx; color: #666; }
.express-arrow { color: #FF6B35; }

.goods-card { padding: 30rpx; }
.goods-title { font-size: 28rpx; font-weight: bold; display: block; margin-bottom: 16rpx; }
.goods-item { display: flex; padding: 16rpx 0; border-top: 1rpx solid #f5f5f5; }
.goods-img { width: 120rpx; height: 120rpx; border-radius: 8rpx; margin-right: 16rpx; }
.goods-info { flex: 1; min-width: 0; }
.goods-name { font-size: 28rpx; display: block; }
.goods-spec { font-size: 22rpx; color: #999; display: block; margin: 4rpx 0; }
.goods-bottom { display: flex; justify-content: space-between; align-items: center; }
.goods-qty { color: #999; }

.info-card { padding: 30rpx; }
.info-title { font-size: 28rpx; font-weight: bold; display: block; margin-bottom: 16rpx; }
.info-row { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 26rpx; color: #666; }

.bottom-actions { position: fixed; bottom: 0; left: 0; right: 0; display: flex; justify-content: flex-end; padding: 20rpx 30rpx; background: #fff; box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05); }
.action-btn { padding: 16rpx 40rpx; font-size: 28rpx; border-radius: 40rpx; margin-left: 20rpx; }
.action-btn.outline { border: 2rpx solid #ddd; color: #666; }
.action-btn.primary { background: #FF6B35; color: #fff; }
