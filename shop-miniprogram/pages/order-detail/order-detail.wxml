<!-- 订单详情页 -->
<view class="page-order-detail" wx:if="{{order}}">
  <!-- 订单状态 -->
  <view class="status-header" style="background: {{statusColor}}">
    <text class="status-text">{{order.status === 0 ? '待支付' : order.status === 1 ? '待发货' : order.status === 2 ? '已发货' : order.status === 3 ? '已完成' : '已取消'}}</text>
    <text class="status-desc" wx:if="{{order.status === 0}}">请在30分钟内完成支付</text>
    <text class="status-desc" wx:if="{{order.status === 2}}">快递正在配送中</text>
    <text class="status-desc" wx:if="{{order.status === 3}}">感谢您的购买，欢迎再次光临</text>
  </view>

  <!-- 收货地址 -->
  <view class="card address-card" wx:if="{{order.address_snapshot}}">
    <text class="address-title">收货信息</text>
    <view class="address-row">
      <text class="address-name">{{order.address_snapshot.name}}</text>
      <text class="address-phone">{{order.address_snapshot.phone}}</text>
    </view>
    <text class="address-detail">{{order.address_snapshot.province}}{{order.address_snapshot.city}}{{order.address_snapshot.district}} {{order.address_snapshot.detail}}</text>
  </view>

  <!-- 物流信息 -->
  <view class="card express-card" wx:if="{{order.express_company}}" bindtap="viewExpress">
    <text class="express-title">物流信息</text>
    <view class="express-row">
      <text>{{order.express_company}}：{{order.express_no}}</text>
      <text class="express-arrow">查看 ></text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="card goods-card">
    <text class="goods-title">商品信息</text>
    <view class="goods-item" wx:for="{{order.items}}" wx:key="id">
      <image class="goods-img" src="{{item.product_cover}}" mode="aspectFill" />
      <view class="goods-info">
        <text class="goods-name text-ellipsis">{{item.product_name}}</text>
        <text class="goods-spec" wx:if="{{item.spec_name}}">{{item.spec_name}}</text>
        <view class="goods-bottom">
          <text class="price"><text class="price-symbol">¥</text>{{item.price}}</text>
          <text class="goods-qty">×{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="card info-card">
    <text class="info-title">订单信息</text>
    <view class="info-row"><text>订单编号</text><text>{{order.order_no}}</text></view>
    <view class="info-row"><text>下单时间</text><text>{{order.created_at}}</text></view>
    <view class="info-row" wx:if="{{order.pay_time}}"><text>支付时间</text><text>{{order.pay_time}}</text></view>
    <view class="info-row"><text>商品金额</text><text>¥{{order.total_amount}}</text></view>
    <view class="info-row"><text>实付金额</text><text class="price">¥{{order.pay_amount}}</text></view>
    <view class="info-row" wx:if="{{order.remark}}"><text>买家备注</text><text>{{order.remark}}</text></view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-actions" wx:if="{{order.status === 0 || order.status === 2}}">
    <view class="action-btn outline" wx:if="{{order.status === 0}}" bindtap="cancelOrder">取消订单</view>
    <view class="action-btn primary" wx:if="{{order.status === 0}}" bindtap="payNow">去支付</view>
    <view class="action-btn primary" wx:if="{{order.status === 2}}" bindtap="confirmReceive">确认收货</view>
  </view>
</view>
