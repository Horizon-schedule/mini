# ========== 服务器配置 ==========
PORT = 3000

# ========== 数据库配置 ==========
DB_HOST = localhost
DB_PORT = 3306
DB_USER = root
DB_PASSWORD = your_password
DB_NAME = shop_mini

# ========== JWT 配置 ==========
JWT_SECRET = your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN = 7d

# ========== 微信小程序配置 ==========
# 微信小程序 AppID 和 AppSecret（在微信公众平台获取）
WX_APPID = your_wx_appid
WX_APPSECRET = your_wx_appsecret

# ========== 微信支付 V3 配置 ==========
# 商户号（微信支付商户平台获取）
WX_MCH_ID = your_merchant_id
# APIv3 密钥（微信支付商户平台设置）
WX_MCH_APIV3_KEY = your_apiv3_key
# 商户API证书序列号
WX_MCH_SERIAL_NO = your_serial_no
# 商户私钥文件路径（相对于项目根目录）
WX_MCH_PRIVATE_KEY_PATH = ./certs/apiclient_key.pem
# 微信支付平台证书路径
WX_PLATFORM_CERT_PATH = ./certs/wechatpay.pem
# 支付回调通知地址（必须是 HTTPS，公网可访问）
WX_PAY_NOTIFY_URL = https://yourdomain.com/api/pay/notify

# ========== 快递查询配置 ==========
# 快递100 配置（https://www.kuaidi100.com/ 开通服务后获取）
EXPRESS_KEY = your_kuaidi100_key
EXPRESS_CUSTOMER = your_kuaidi100_customer
# 备选：阿里云物流查询（如用阿里云，填此项）
ALIYUN_EXPRESS_APPCODE = your_aliyun_appcode

# ========== 上传配置 ==========
# 上传文件保存路径
UPLOAD_PATH = ./public/uploads
# 服务端公网地址（用于生成图片访问URL）
SERVER_URL = http://localhost:3000

# ========== 管理员默认账号 ==========
# 首次启动时会自动创建，请在数据库中修改密码
DEFAULT_ADMIN_USERNAME = admin
DEFAULT_ADMIN_PASSWORD = admin123
